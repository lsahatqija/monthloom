{
  "name": "monthloom",
  "version": "0.1.0",
  "private": true,
  "description": "Expense tracker built on TypeScript (Express 5 API + Next.js App Router frontend + PostgreSQL).",
  "engines": {
    "node": ">=20.11.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.7.0",
  "scripts": {
    "postinstall": "pnpm --filter @template/contracts run build",
    "dev": "pnpm --parallel --filter @template/contracts --filter ./apps/* run dev",
    "dev:api": "pnpm --filter @template/api run dev",
    "dev:web": "pnpm --filter @template/web run dev",
    "build": "pnpm --recursive run build",
    "typecheck": "pnpm --recursive run typecheck",
    "lint": "pnpm --recursive run lint",
    "lint:fix": "pnpm --recursive run lint:fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "docker:up": "docker compose -f compose.yml up -d",
    "docker:down": "docker compose -f compose.yml down",
    "docker:logs": "docker compose -f compose.yml logs -f",
    "db:migrate": "pnpm --filter @template/api run db:migrate",
    "db:seed": "pnpm --filter @template/api run db:seed",
    "email:templates:sync": "pnpm --filter @template/api run email:templates:sync",
    "clean": "pnpm --recursive run clean",
    "test": "vitest run",
    "test:unit": "vitest run --project=*-unit",
    "test:integration": "vitest run --project=*-integration",
    "test:api": "vitest run --project=api-*",
    "test:web": "vitest run --project=web-*",
    "test:contracts": "vitest run --project=contracts-unit",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ci": "pnpm typecheck && pnpm test:typecheck && vitest run --coverage --reporter=default --reporter=junit --outputFile.junit=test-results/junit.xml",
    "test:typecheck": "pnpm --filter @template/api exec tsc -p tsconfig.test.json && pnpm --filter @template/contracts exec tsc -p tsconfig.test.json",
    "test:db:up": "docker compose -f compose.test.yml up -d --wait",
    "test:db:down": "docker compose -f compose.test.yml down"
  },
  "pnpm": {
    "overrides": {
      "vite": "^6.0.0"
    }
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^3.2.0",
    "prettier": "^3.3.3",
    "typescript": "^5.5.4",
    "vitest": "^3.2.0",
    "vitest-mock-extended": "^3.1.0"
  }
}
