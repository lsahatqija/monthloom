# Copy this file to .env (and/or apps/api/.env, apps/web/.env.local) and fill in real values.
# Never commit an actual .env file. No secrets below are real.

# ---------------------------------------------------------------------------
# Backend-only variables (apps/api) — never exposed to the browser.
# ---------------------------------------------------------------------------
NODE_ENV=development

API_PORT=4000
API_PUBLIC_URL=http://localhost:4000
WEB_PUBLIC_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000

DATABASE_URL=postgres://template:template@localhost:5432/template_dev

SESSION_SECRET=please-change-this-to-a-long-random-development-secret
SESSION_DURATION_HOURS=168
SESSION_COOKIE_NAME=template_session
SESSION_COOKIE_SECURE=false

JSON_BODY_LIMIT=1mb

UPLOAD_DIR=uploads
UPLOAD_MAX_SIZE_BYTES=5242880
UPLOAD_ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp

LOG_LEVEL=info

RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX_REQUESTS=300
AUTH_RATE_LIMIT_MAX_REQUESTS=10

TRUSTED_PROXY_HOPS=0

# Development-only seed credentials. Never used as production defaults, never seeded in production.
SEED_ADMIN_EMAIL=admin@example.local
SEED_ADMIN_PASSWORD=DevAdminPass123!
SEED_USER_EMAIL=user@example.local
SEED_USER_PASSWORD=DevUserPass123!

# ---------------------------------------------------------------------------
# Frontend variables (apps/web)
# ---------------------------------------------------------------------------

# Server-only: base URL the Next.js server uses to reach the API (e.g. Docker service name).
API_INTERNAL_URL=http://localhost:4000

# Public: exposed to the browser bundle. Only intentionally public values belong here.
NEXT_PUBLIC_API_URL=http://localhost:4000

# ---------------------------------------------------------------------------
# Docker Compose only
# ---------------------------------------------------------------------------
POSTGRES_USER=template
POSTGRES_PASSWORD=template
POSTGRES_DB=template_dev
