{
	email {$ACME_EMAIL}
}

{$DOMAIN} {
	encode zstd gzip

	@backend path /api/* /health/*
	handle @backend {
		reverse_proxy api:4000
	}

	handle {
		reverse_proxy web:3000
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}

	log {
		output stdout
		format json
	}
}
