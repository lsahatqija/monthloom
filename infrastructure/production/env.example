# Copy to /opt/monthloom/.env.production on the server and run: chmod 600 .env.production
# Do not commit the populated file. Values must not contain unescaped Compose interpolation ($).

# Public hostname only: no scheme, slash, or path.
DOMAIN=monthloom.example.com
ACME_EMAIL=ops@example.com

# Use "latest" with the systemd auto-update timer. CI also publishes immutable commit-SHA tags,
# which can be selected here for a manual deployment or rollback.
IMAGE_TAG=latest

# Existing dm-crypt/LUKS-backed mount. The deployment fails closed if this path is not backed by
# a block-device chain containing a `crypt` layer. Keep the PostgreSQL subdirectory on this mount.
ENCRYPTED_STORAGE_ROOT=/srv/monthloom-encrypted

POSTGRES_USER=monthloom
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=monthloom
# URL-encode reserved characters in the username or password.
DATABASE_URL=postgres://monthloom:replace-with-a-long-random-password@postgres:5432/monthloom

# Public age recipient only. Generate the identity on a separate trusted machine with
# `age-keygen`; never put the private identity on this host except temporarily for a restore.
BACKUP_AGE_RECIPIENT=age1replace_with_your_public_backup_recipient
# Optional rclone destination. Strongly recommended so loss of this server does not lose backups.
# Configure rclone credentials separately with the narrowest possible write/read permissions.
BACKUP_REMOTE=

# Generate with: openssl rand -hex 32
SESSION_SECRET=replace-with-at-least-32-random-bytes

EMAIL_TRANSPORT=resend
EMAIL_FROM_ADDRESS=no-reply@example.com
EMAIL_REPLY_TO=support@example.com
RESEND_API_KEY=re_replace_me

LOG_LEVEL=info
UPLOAD_MAX_SIZE_BYTES=5242880
UPLOAD_ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp
