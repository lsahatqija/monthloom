# Safe, non-secret API defaults shared by local and production Compose workflows.
API_PORT=4000
SESSION_DURATION_HOURS=168
SESSION_COOKIE_NAME=monthloom_session
JSON_BODY_LIMIT=1mb
UPLOAD_MAX_SIZE_BYTES=5242880
UPLOAD_ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp
EMAIL_FROM_NAME=Monthloom
FEEDBACK_EMAIL_ADDRESS=feedback@monthloom.local
LOG_LEVEL=info
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX_REQUESTS=300
AUTH_RATE_LIMIT_WINDOW_MINUTES=15
AUTH_RATE_LIMIT_MAX_REQUESTS=10
PASSWORD_RESET_RATE_LIMIT_WINDOW_MINUTES=30
PASSWORD_RESET_RATE_LIMIT_MAX_REQUESTS=5
EMAIL_VERIFICATION_RATE_LIMIT_WINDOW_MINUTES=60
EMAIL_VERIFICATION_RATE_LIMIT_MAX_REQUESTS=10
